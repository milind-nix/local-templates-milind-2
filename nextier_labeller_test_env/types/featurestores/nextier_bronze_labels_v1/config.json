{
  "key": "nextier_bronze_labels_v1",
  "displayName": "Nextier Bronze Labels V1",
  "description": "Row-level bronze continuous substage labels computed directly from telemetry using the DS bronze FSM.",
  "sql": "SELECT CAST(NULL AS TEXT) AS telemetry_point_id, fleet_name, pad_name, name AS well_name, id AS well_id, api_num, record_ts, created_ts, CAST(NULL AS TEXT) AS bronze_continuous, rate_slurry, press_mainline, prop_conc_blend_denso, prop_conc_blend_auger, prop_conc_inline, prop_conc_target, CAST(NULL AS TEXT) AS algorithm_version, CAST(NULL AS TEXT) AS source_mode, CAST(NULL AS TEXT) AS processed_at FROM datastore:merged_fleet_stream_customer_full_v2 WHERE 1 = 0",
  "checkpoint_fields": [],
  "upsert": true,
  "dataSchema": {
    "type": "object",
    "properties": {
      "telemetry_point_id": {
        "type": "string",
        "metadata": {
          "isPrimaryKey": true
        }
      },
