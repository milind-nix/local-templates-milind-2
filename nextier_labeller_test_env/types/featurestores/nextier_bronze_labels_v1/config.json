      },
      "api_num": {
        "type": "string"
      },
      "record_ts": {
        "type": "string",
        "format": "date-time"
      },
      "created_ts": {
        "type": "string",
        "format": "date-time"
      },
      "bronze_continuous": {
        "type": "string"
      },
      "rate_slurry": {
        "type": "number"
      },
      "press_mainline": {
        "type": "number"
      },
      "prop_conc_blend_denso": {
