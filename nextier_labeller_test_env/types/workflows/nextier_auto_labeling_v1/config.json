{
  "key": "nextier_auto_labeling_v1",
  "displayName": "Nextier Auto Labeling V1",
  "description": "Standalone Auto substage labeling over copper continuous stage windows. Not wired into bronze/copper orchestration yet.",
  "runtime": "prefect",
  "flow": {
    "entrypoint": "scripts/workflows/nextier_auto_labeling_v1/main.py:nextier_auto_labeling_v1_flow",
    "include": [
      "scripts/workflows/nextier_auto_labeling_v1/**/*.py",
      "scripts/workflows/nextier_labeling_common_v1/**/*.py"
    ],
    "tags": [
      "nextier",
      "labeling",
      "auto",
      "substage"
    ]
  },
  "deployment": {
    "workPool": "default",
    "timezone": "UTC",
    "concurrencyLimit": 1,
    "parameters": {
      "mode": "historical",
      "copper_featurestore_key": "nextier_copper_labels_v1",
      "stage_index_featurestore_key": "nextier_copper_stage_index_v1",
      "auto_labels_featurestore_key": "nextier_auto_labels_v1",
      "auto_summary_featurestore_key": "nextier_auto_stage_summary_v1",
      "auto_manifest_featurestore_key": "nextier_auto_processing_manifest_v1",
      "lookback_hours": 24,
      "max_wells": 2,
      "max_stages": 10,
      "skip_completed": true,
      "delete_existing": false,
      "dry_run": false,
      "algorithm_version": "nextier_auto_layer_v1",
      "concentration_feature": "all"
    },
    "concurrencyCollisionStrategy": "CANCEL_NEW"
  },
  "paramsSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "live",
          "background",
          "historical",
          "debug"
        ],
        "default": "historical"
      },
      "copper_featurestore_key": {
        "type": "string",
        "default": "nextier_copper_labels_v1"
      },
      "stage_index_featurestore_key": {
        "type": "string",
        "default": "nextier_copper_stage_index_v1"
      },
      "auto_labels_featurestore_key": {
        "type": "string",
        "default": "nextier_auto_labels_v1"
      },
      "auto_summary_featurestore_key": {
        "type": "string",
        "default": "nextier_auto_stage_summary_v1"
      },
      "auto_manifest_featurestore_key": {
        "type": "string",
        "default": "nextier_auto_processing_manifest_v1"
      },
      "well_name": {
        "type": "string"
      },
      "well_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional explicit wells to process incrementally. Combined with well_name if both are supplied."
      },
      "fleet_name": {
        "type": "string"
      },
      "include_fleet_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional fleet names to include. Use this to partition Auto labeling runs by fleet."
      },
      "exclude_fleet_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional fleet names to exclude. Cannot be used with include_fleet_names."
      },
      "pad_name": {
        "type": "string"
      },
      "stage_num": {
        "type": "number"
      },
      "start_time": {
        "type": "string",
        "format": "date-time"
      },
      "end_time": {
        "type": "string",
        "format": "date-time"
      },
      "lookback_hours": {
        "type": "number",
        "minimum": 0,
        "default": 24
      },
      "max_wells": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 2
      },
      "max_stages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 10
      },
      "skip_completed": {
        "type": "boolean",
        "default": true
      },
      "delete_existing": {
        "type": "boolean",
        "default": false
      },
      "recompute": {
        "type": "boolean",
        "default": false,
        "description": "When true, clears matching Auto manifest progress once for recompute_run_key before incremental processing."
      },
      "recompute_run_key": {
        "type": "string",
        "description": "Stable key for one Auto recompute campaign. Required when recompute is true."
      },
      "dry_run": {
        "type": "boolean",
        "default": false
      },
      "algorithm_version": {
        "type": "string",
        "default": "nextier_auto_layer_v1"
      },
      "concentration_feature": {
        "type": "string",
        "enum": [
          "all",
          "denso",
          "inline",
          "target",
          "auger",
          "auto"
        ],
        "default": "all",
        "description": "Concentration channels used by the Auto labeler. all processes denso, inline, target, and auger in one run; auto lets the DS resolver choose one best channel."
      }
    },
    "required": []
  },
  "initialState": {}
}
