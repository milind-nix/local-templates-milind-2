{
  "runtime": "prefect",
  "flow": {
    "entrypoint": "scripts/workflows/nextier_titanium_stage_orchestration_v2/main.py:nextier_titanium_stage_orchestration_v2_flow",
    "include": [
      "scripts/workflows/nextier_titanium_stage_orchestration_v2/**/*.py",
      "scripts/workflows/nextier_labeling_common_v1/**/*.py"
    ],
    "tags": [
      "nextier",
      "stage-detection",
      "titanium",
      "historical",
      "beta",
      "priority-wells"
    ]
  },
  "paramsSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "live",
          "background",
          "historical",
          "debug"
        ]
      },
      "source_datastore_key": {
        "type": "string",
        "default": "merged_fleet_stream_customer_full_v2"
      },
      "well_name": {
        "type": "string"
      },
      "fleet_name": {
        "type": "string"
      },
      "include_fleet_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional fleet names to include. Use this to partition runs by fleet."
      },
      "exclude_fleet_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional fleet names to exclude. Cannot be used with include_fleet_names."
      },
      "pad_name": {
        "type": "string"
      },
      "start_time": {
        "type": "string",
        "format": "date-time"
      },
      "end_time": {
        "type": "string",
        "format": "date-time"
      },
      "lookback_hours": {
        "type": "number",
        "minimum": 0
      },
      "context_hours": {
        "type": "number",
        "minimum": 0,
        "description": "Telemetry context loaded before the selected Titanium window. Context rows are not written."
      },
      "boundary_context_hours": {
        "type": "number",
        "minimum": 0,
        "default": 0.5,
        "description": "Hours added around an existing Titanium boundary stage when a window cuts through it."
      },
      "max_boundary_expansion_hours": {
        "type": "number",
        "minimum": 0,
        "default": 96,
        "description": "Maximum left/right expansion allowed while making the Titanium window stage-safe."
      },
      "max_wells": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "description": "Maximum wells processed per time chunk."
      },
      "delete_existing": {
        "type": "boolean",
        "default": true
      },
      "dry_run": {
        "type": "boolean",
        "default": false
      },
      "algorithm_version": {
        "type": "string",
        "default": "nextier_titanium_stage_v2"
      },
      "chunk_hours": {
        "type": "number",
        "minimum": 0,
        "default": 6
      },
      "max_chunks": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      },
      "skip_completed": {
        "type": "boolean",
        "default": false
      },
      "titanium_labels_featurestore_key": {
        "type": "string",
        "default": "nextier_titanium_labels_v2"
      },
      "titanium_stage_index_featurestore_key": {
        "type": "string",
        "default": "nextier_titanium_stage_index_v2"
      },
      "titanium_manifest_featurestore_key": {
        "type": "string",
        "default": "nextier_titanium_processing_manifest_v2"
      },
      "well_names": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "concentration_feature": {
        "type": "string",
        "default": "auger",
        "enum": [
          "auger",
          "denso",
          "inline",
          "target"
        ]
      }
    },
    "required": []
  },
  "initialState": {},
  "key": "nextier_titanium_stage_priority_wells_v2",
  "displayName": "Nextier Titanium Stage - Priority Wells V2 (Beta)",
  "description": "BETA Titanium stage detection for the agreed priority wells only, pinned by name so they never queue behind a heavy fleet. Same 17 wells as the Sapphire priority workflow. Run this to completion first, then widen to the live / background / historical V2 deployments.\n\nchunk_hours is 4000 deliberately. Historical Titanium chunks per well, but the chunk boundaries sit on a GLOBAL grid anchored at the collective scope start, and these 17 wells span 531 days (2025-01-30 to 2026-07-16) even though the widest single well is only 29 days. At 720-800 h, 7-9 of the 17 wells straddle a boundary and get split into two runs -- which is what produced 40 stages instead of 38 on AUSTIN 474-1004H, and leaves single-stage chunks with no sand mass because titanium_merge returns early below two spans. At 4000 h no well is split.",
  "deployment": {
    "workPool": "nextier-backfill",
    "timezone": "UTC",
    "concurrencyLimit": 1,
    "parameters": {
      "mode": "historical",
      "source_datastore_key": "merged_fleet_stream_customer_full_v2",
      "lookback_hours": 0,
      "context_hours": 0.5,
      "boundary_context_hours": 0.5,
      "max_boundary_expansion_hours": 96,
      "chunk_hours": 4000,
      "max_chunks": null,
      "max_wells": 25,
      "delete_existing": true,
      "dry_run": false,
      "skip_completed": true,
      "algorithm_version": "nextier_titanium_stage_v2",
      "well_names": [
        "ALLIGATOR GAHR 27 28 F101AP",
        "ARROW PEAK 7-6 UNIT 4AH",
        "ARROW PEAK 7-6 UNIT 5AH",
        "CANAL 20/19 FED COM 716H",
        "GLACIER 3510-01H",
        "GLACIER 3511-02H",
        "GLACIER 3511-03H",
        "GLACIER 3511-04H",
        "HAWKEYE 174-1336H",
        "HAWKEYE 176-1336H",
        "HAWKEYE 177-1324H",
        "HAWKEYE 31-1336H",
        "HAWKEYE 33-1324H",
        "HOWITZER 0226-30H",
        "NAIAD 15-03 3AH",
        "PRETTY GOOD 20 FED COM 214H",
        "WENDIGO UNIT A 10-15 2MH"
      ],
      "titanium_labels_featurestore_key": "nextier_titanium_labels_v2",
      "titanium_stage_index_featurestore_key": "nextier_titanium_stage_index_v2",
      "titanium_manifest_featurestore_key": "nextier_titanium_processing_manifest_v2",
      "concentration_feature": "auger"
    },
    "concurrencyCollisionStrategy": "CANCEL_NEW"
  }
}
