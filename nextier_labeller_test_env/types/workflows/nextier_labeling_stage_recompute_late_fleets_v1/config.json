{
  "key": "nextier_labeling_stage_recompute_late_fleets_v1",
  "displayName": "Nextier Stage Recompute - Late Fleets V1",
  "description": "Manual bronze-to-copper stage correction workflow for Frac 04, Frac 09, and Frac 81. Uses stage-aware boundary expansion and runs on the Nextier backfill work pool.",
  "runtime": "prefect",
  "flow": {
    "entrypoint": "scripts/workflows/nextier_labeling_orchestration_v1/main.py:nextier_labeling_orchestration_v1_flow",
    "include": [
      "scripts/workflows/nextier_labeling_orchestration_v1/**/*.py",
      "scripts/workflows/nextier_bronze_labeling_v1/**/*.py",
      "scripts/workflows/nextier_copper_labeling_v1/**/*.py",
      "scripts/workflows/nextier_labeling_common_v1/**/*.py",
      "scripts/workflows/nextier_auto_labeling_v1/**/*.py"
    ],
    "tags": [
      "nextier",
      "labeling",
      "bronze",
      "copper",
      "stage-correction",
      "historical",
      "temp",
      "frac-04",
      "frac-09",
      "frac-81"
    ]
  },
  "deployment": {
    "workPool": "nextier-backfill",
    "timezone": "UTC",
    "concurrencyLimit": 1,
    "parameters": {
      "mode": "historical",
      "source_datastore_key": "merged_fleet_stream_customer_full_v2",
      "bronze_featurestore_key": "nextier_bronze_labels_v1",
      "copper_featurestore_key": "nextier_copper_labels_v1",
      "stage_index_featurestore_key": "nextier_copper_stage_index_v1",
      "manifest_featurestore_key": "nextier_labeling_processing_manifest_v1",
      "include_fleet_names": [
        "Frac 09",
        "Frac 04",
        "Frac 81"
      ],
      "max_wells": 5,
      "max_chunks": 3,
      "chunk_hours": 24,
      "lookback_hours": 0,
      "boundary_context_hours": 0.5,
      "max_boundary_expansion_hours": 96,
      "skip_completed": true,
      "delete_existing": true,
      "recompute": false,
      "dry_run": false,
      "algorithm_version": "nextier_bronze_copper_fullwell_v1",
      "run_auto_labeling_after_stage": false
    },
    "concurrencyCollisionStrategy": "CANCEL_NEW"
  },
  "paramsSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "live",
          "background",
          "historical",
          "debug"
        ],
        "default": "historical"
      },
      "source_datastore_key": {
        "type": "string",
        "default": "merged_fleet_stream_customer_full_v2"
      },
      "bronze_featurestore_key": {
        "type": "string",
        "default": "nextier_bronze_labels_v1"
      },
      "copper_featurestore_key": {
        "type": "string",
        "default": "nextier_copper_labels_v1"
      },
      "stage_index_featurestore_key": {
        "type": "string",
        "default": "nextier_copper_stage_index_v1"
      },
      "manifest_featurestore_key": {
        "type": "string",
        "default": "nextier_labeling_processing_manifest_v1"
      },
      "well_name": {
        "type": "string"
      },
      "well_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional explicit wells to process incrementally. Combined with well_name if both are supplied."
      },
      "fleet_name": {
        "type": "string"
      },
      "include_fleet_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional fleet names to include. This deployment defaults to Frac 04, Frac 09, and Frac 81."
      },
      "exclude_fleet_names": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional fleet names to exclude. Cannot be used with include_fleet_names."
      },
      "pad_name": {
        "type": "string"
      },
      "start_time": {
        "type": "string",
        "format": "date-time"
      },
      "end_time": {
        "type": "string",
        "format": "date-time"
      },
      "lookback_hours": {
        "type": "number",
        "minimum": 0,
        "default": 0
      },
      "context_hours": {
        "type": "number",
        "minimum": 0,
        "description": "Optional algorithm context before each chunk. If omitted, historical uses lookback_hours. This does not change the target range."
      },
      "max_wells": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 5,
        "description": "Maximum wells processed per historical window."
      },
      "delete_existing": {
        "type": "boolean",
        "default": true
      },
      "recompute": {
        "type": "boolean",
        "default": false,
        "description": "When true, clears matching historical manifest progress once for recompute_run_key before incremental processing. Use only with a finite start_time/end_time."
      },
      "recompute_run_key": {
        "type": "string",
        "description": "Stable key for one recompute campaign. Required when recompute is true."
      },
      "dry_run": {
        "type": "boolean",
        "default": false
      },
      "algorithm_version": {
        "type": "string",
        "default": "nextier_bronze_copper_fullwell_v1"
      },
      "chunk_hours": {
        "type": "number",
        "minimum": 0,
        "default": 24,
        "description": "Historical planner chunk size. Bronze and copper still expand each selected chunk to safe full-stage boundaries before computing."
      },
      "max_chunks": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 3
      },
      "skip_completed": {
        "type": "boolean",
        "default": true
      },
      "run_auto_labeling_after_stage": {
        "type": "boolean",
        "default": false,
        "description": "When true, run Auto substage labeling after each stage/copper orchestration chunk that writes stage outputs."
      },
      "auto_labels_featurestore_key": {
        "type": "string",
        "default": "nextier_auto_labels_v1"
      },
      "auto_summary_featurestore_key": {
        "type": "string",
        "default": "nextier_auto_stage_summary_v1"
      },
      "auto_manifest_featurestore_key": {
        "type": "string",
        "default": "nextier_auto_processing_manifest_v1"
      },
      "auto_algorithm_version": {
        "type": "string",
        "default": "nextier_auto_layer_v1"
      },
      "auto_concentration_feature": {
        "type": "string",
        "default": "all",
        "enum": [
          "all",
          "auger",
          "denso",
          "inline",
          "target"
        ]
      },
      "auto_max_stages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 100
      },
      "boundary_context_hours": {
        "type": "number",
        "minimum": 0,
        "default": 0.5,
        "description": "Extra cushion before a boundary stage when a chunk/context start falls inside an existing stage window."
      },
      "max_boundary_expansion_hours": {
        "type": "number",
        "minimum": 0,
        "default": 96,
        "description": "Maximum hours the stage-safe boundary resolver can walk before falling back to the bounded window."
      }
    },
    "required": []
  },
  "initialState": {}
}
