{
  "key": "nextier_merged_well_index_refresh_v1",
  "displayName": "Nextier Merged Well Index Refresh",
  "description": "Refreshes merged well index rows for wells with new merged raw telemetry.",
  "runtime": "prefect",
  "flow": {
    "entrypoint": "scripts/workflows/nextier_merged_well_index_refresh_v1/main.py:nextier_merged_well_index_refresh_v1_flow",
    "include": [
      "scripts/workflows/nextier_merged_well_index_refresh_v1/**/*.py",
      "scripts/workflows/nextier_merged_well_recompute/**/*.py",
      "scripts/workflows/nextier_live_stage_processing/**/*.py"
    ],
    "tags": [
      "nextier",
      "merged-labeller",
      "well-index"
    ]
  },
  "deployment": {
    "workPool": "default",
    "timezone": "UTC",
    "cron": "*/5 * * * *",
    "concurrencyLimit": 1,
    "parameters": {
      "batch_limit": 200000
    },
    "concurrencyCollisionStrategy": "CANCEL_NEW"
  },
  "paramsSchema": {
    "type": "object",
    "properties": {
      "batch_limit": {
        "type": "integer",
        "default": 200000,
        "minimum": 1,
        "maximum": 1000000
      }
    },
    "required": []
  },
  "initialState": {
    "__checkpoint__merged_well_index_created_ts": null
  }
}
